<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lists the manifest resources of .NET assemblies with Microsoft's own
       metadata reader (System.Reflection.Metadata, part of .NET itself), so
       baghban's pure-Python reader can be compared with it. No packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
</Project>
